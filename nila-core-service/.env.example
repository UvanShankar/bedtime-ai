PORT=8080
NODE_ENV=development
AWS_REGION=ap-south-1

# JWT Auth
JWT_ACCESS_SECRET=super_secret_access_jwt_key_123
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_456
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# DynamoDB Table Names
DYNAMODB_USERS_TABLE=Nila_Users_dev
DYNAMODB_OTP_TABLE=Nila_Otp_dev
DYNAMODB_CHILDREN_TABLE=Nila_Children_dev
DYNAMODB_MEMORIES_TABLE=Nila_Memories_dev
DYNAMODB_VOICE_PROFILES_TABLE=Nila_VoiceProfiles_dev
DYNAMODB_STORIES_TABLE=Nila_Stories_dev
DYNAMODB_PLAYBACK_TABLE=Nila_PlaybackSessions_dev

# S3 & CDN
UPLOADS_BUCKET=nila-media-uploads-dev
STORY_AUDIO_BUCKET=nila-story-audio-dev
CDN_URL=https://cdn.nila.app

# SQS Queue URLs
STORY_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/nila-story-generation-queue-dev.fifo

# Generic AI Service Connection
AI_SERVICE_URL=http://localhost:8081
AI_SERVICE_API_KEY=test-ai-key-secret-12345

# Debug / LocalStack
DEBUG=false
DYNAMODB_ENDPOINT=http://localhost:4566
